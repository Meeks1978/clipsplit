# ClipSplit — sandbox credentials template. Copy to .env (gitignored) and
# fill in from the PayPal Developer dashboard for the "ClipSplit" sandbox app.
# Never commit a filled .env. Sandbox only — no live credentials.
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=

# Sandbox recipient mapping used by batchPreview / the executor.
# Replace the placeholder sb-<clipperId>@example.com addresses with the
# actual sandbox personal-account emails confirmed in the owner sitting.
# Format: clipperId=email, comma-separated.
# Sample ledger clippers: operator, clipper-b
PAYPAL_SANDBOX_RECIPIENTS=operator=,clipper-b=
